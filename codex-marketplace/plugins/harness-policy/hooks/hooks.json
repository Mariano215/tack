{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$PLUGIN_ROOT/scripts/graph-stale.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$PLUGIN_ROOT/scripts/security-file-nudge.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
