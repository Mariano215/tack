{
  "cleanupPeriodDays": 60,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CAVEMAN_DEFAULT_MODE": "off",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4"
  },
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\": \"\u26a0\ufe0f Auto-compact firing: context window at limit. Committed work is safe; in-flight intent may be summarized.\"}'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "c=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"; if [ -f \"$c/hooks/skill-router.sh\" ]; then bash \"$c/hooks/skill-router.sh\"; fi",
            "timeout": 5,
            "statusMessage": "Routing intent..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$(command -v python3 || command -v python)\"; c=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"; if [ -n \"$p\" ] && [ -f \"$c/ghost/ghost_precheck.py\" ]; then \"$p\" \"$c/ghost/ghost_precheck.py\"; fi",
            "timeout": 10,
            "statusMessage": "ghost slop check..."
          },
          {
            "type": "command",
            "command": "p=\"$(command -v python3 || command -v python)\"; c=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"; if [ -n \"$p\" ] && [ -f \"$c/auditor/hooks/citation-validator.py\" ]; then \"$p\" \"$c/auditor/hooks/citation-validator.py\"; fi",
            "timeout": 10,
            "statusMessage": "citation mode check..."
          }
        ]
      },
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "c=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"; if [ -f \"$c/hooks/model-router-nudge.sh\" ]; then bash \"$c/hooks/model-router-nudge.sh\"; fi",
            "timeout": 5,
            "statusMessage": "Checking model/effort tier..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty' 2>/dev/null); [[ \"$f\" == *graphify-out* ]] && exit 0; [ -f \"graphify-out/graph.json\" ] || exit 0; touch graphify-out/.needs_update 2>/dev/null; jq -n --arg f \"$f\" '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":(\"graphify: file written (\" + $f + \"): graph stale. Run /graphify . --update before next graph query.\")}}' 2>/dev/null || true",
            "statusMessage": "Flagging graphify update..."
          },
          {
            "type": "command",
            "command": "c=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"; if [ -f \"$c/hooks/security-file-nudge.sh\" ]; then bash \"$c/hooks/security-file-nudge.sh\"; fi"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "c=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"; if [ -f \"$c/hooks/capture-plan.sh\" ]; then bash \"$c/hooks/capture-plan.sh\"; fi",
            "statusMessage": "Capturing plan to .agent/..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "c=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"; if [ -f \"$c/hooks/plugin-auto-update.sh\" ]; then bash \"$c/hooks/plugin-auto-update.sh\"; fi",
            "async": true,
            "statusMessage": "Checking for plugin updates..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "c=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"; if [ -f \"$c/hooks/session-summary.sh\" ]; then bash \"$c/hooks/session-summary.sh\"; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline-command.sh\""
  },
  "enabledPlugins": {
    "ponytail@ponytail": false,
    "caveman@caveman": false,
    "security-guidance@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": false,
    "claude-mem@thedotmack": false,
    "typescript-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "codex@openai-codex": false,
    "frontend-design@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "telegram@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "ui-ux-pro-max@ui-ux-pro-max-skill": false,
    "agent-skills@addy-agent-skills": false,
    "frontend-slides@frontend-slides": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "addy-agent-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/addyosmani/agent-skills.git"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "frontend-slides": {
      "source": {
        "source": "github",
        "repo": "zarazhangrui/frontend-slides"
      }
    },
    "nateherk": {
      "source": {
        "source": "github",
        "repo": "nateherkai/scroll-craft"
      }
    }
  },
  "agent": "task-orchestrator",
  "autoUpdatesChannel": "latest",
  "autoMemoryEnabled": false,
  "useAutoModeDuringPlan": true
}
