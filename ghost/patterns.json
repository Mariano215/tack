{
  "_comment": "ghost de-slop pattern config. Single source of truth for the scanner, the PreToolUse hook and the /ghost command. Edit allowlist to permit legit domain terms. Move a category between file_block_categories and file_warn_categories to change strictness without touching code.",
  "_comment_scope": "scan_extensions is the whole gate for the PreToolUse hook, and it lists only the formats a client document leaves in. Markdown is excluded on purpose: .md here is internal (notes, READMEs, plans, skills), and a block costs a full rewrite. Adding .md back reintroduces that cost. /ghost and ghost_scan.py on the command line scan any file you point them at, extension included.",
  "scan_extensions": [".txt", ".docx", ".pdf"],
  "skip_path_substrings": ["/.claude/ghost/", "/node_modules/", "/.git/", "/_archive", "/_archive-superseded", "/skills/", "/agents/", "/memory/"],
  "file_block_categories": ["dashes", "phrases", "buzzwords"],
  "file_warn_categories": [],
  "chat_warn_categories": ["dashes", "phrases"],
  "bypass_token": "ghost:allow",
  "dashes": ["—", "–", "―"],
  "phrases": [
    "\\bdelv(e|es|ing|ed)\\b",
    "\\bdiv(e|es|ing)\\s+(in|into)\\b",
    "navigat\\w*\\s+the\\s+(complex|landscape|world|complexities|intricacies)",
    "\\btapestr(y|ies)\\b",
    "\\btestament\\s+to\\b",
    "underscor\\w*\\s+the\\b",
    "it'?s\\s+worth\\s+noting",
    "it'?s\\s+important\\s+to\\s+note",
    "needless\\s+to\\s+say",
    "\\bin\\s+conclusion\\b",
    "at\\s+the\\s+end\\s+of\\s+the\\s+day",
    "when\\s+it\\s+comes\\s+to",
    "in\\s+today'?s\\s+(fast-?paced|digital|modern|ever-?changing|world)",
    "ever-?(evolving|changing)",
    "\\bfast-?paced\\b",
    "plays?\\s+a\\s+(crucial|pivotal|vital|key|significant)\\s+role",
    "a\\s+myriad\\s+of",
    "a\\s+plethora\\s+of",
    "treasure\\s+trove",
    "game-?changer",
    "cutting-?edge",
    "look\\s+no\\s+further",
    "rich\\s+(tapestry|history)",
    "\\bfurthermore\\b",
    "\\bmoreover\\b",
    "in\\s+the\\s+realm\\s+of",
    "\\bboast(s|ing|ed)?\\b",
    "seamless\\w*\\s+(integrat|blend|combin|connect)",
    "it'?s\\s+not\\s+just\\s+.{0,50}?\\s+it'?s",
    "not\\s+(just|merely|only)\\s+.{0,45}?\\s+but\\s+(also\\s+)?"
  ],
  "buzzwords": [
    "comprehensive",
    "robust",
    "ensure",
    "leverage",
    "utilize",
    "seamless",
    "streamline",
    "holistic",
    "elevate",
    "empower",
    "foster",
    "facilitate",
    "myriad",
    "plethora",
    "pivotal",
    "crucial",
    "vital",
    "meticulous",
    "meticulously",
    "bustling",
    "vibrant",
    "nestled",
    "intricate",
    "multifaceted",
    "paramount",
    "unleash",
    "unlock",
    "embark",
    "supercharge",
    "revolutionize",
    "transformative",
    "showcasing"
  ],
  "allowlist": ["tack", "claude-auditor"]
}
